Print Dynamic Star Pattern


def print_pattern(n):
    for i in range(1, n + 1):
        print("*" * i)

print_pattern(5)

Flatten a Nested List
def flatten_list(nested):
    flat = []
    for item in nested:
        if isinstance(item, list):
            flat.extend(flatten_list(item)) # Recursive call
        else:
            flat.append(item)
    return flat

my_list = [1, [2, 3], [4, [5, 6]]]
print(flatten_list(my_list)) # Output: [1, 2, 3, 4, 5, 6]

