4. Sort Dictionary by Values

data = {"apple": 10, "orange": 5, "banana": 7}

# Sort by value (x[1])
sorted_data = dict(sorted(data.items(), key=lambda x: x[1]))

print(sorted_data) # {'orange': 5, 'banana': 7, 'apple': 10}

5. Count Vowels, Digits, etc., in a String
def count_chars(s):
    vowels = "aeiouAEIOU"
    counts = {"vowels": 0, "digits": 0, "consonants": 0}
    
    for char in s:
        if char.isdigit():
            counts["digits"] += 1
        elif char.isalpha():
            if char in vowels:
                counts["vowels"] += 1
            else:
                counts["consonants"] += 1
    return counts

print(count_chars("Hello 123!"))

6. Implement OOP (Inheritance & Polymorphism)

class Animal:
    def speak(self):
        pass

class Dog(Animal): # Inheritance
    def speak(self): # Polymorphism (Overriding)
        return "Woof!"

class Cat(Animal):
    def speak(self):
        return "Meow!"

animals = [Dog(), Cat()]
for a in animals:
    print(a.speak())

7. Generator to Yield Even Numbers

def even_generator(n):
    for i in range(0, n + 1, 2):
        yield i

for num in even_generator(10):
    print(num)

8. Remove Duplicates from a List
def remove_duplicates(items):
    return list(dict.fromkeys(items)) # Keeps order

# Or simpler if order doesn't matter: list(set(items))

my_list = [1, 2, 2, 3, 4, 4, 5]
print(remove_duplicates(my_list))
